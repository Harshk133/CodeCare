# SwasthyaAI Environment Variables Configuration

# Toggle Simulation Mode: set to false to connect to real external APIs.
# Set to true to run SwasthyaAI using mock/simulated RAG and Leaflet maps out of the box.
NEXT_PUBLIC_SIMULATION_MODE=true

# AI Model Provider Settings (Only active if Simulation Mode is false)
# Options: gemini | openrouter | openai
NEXT_PUBLIC_AI_PROVIDER=openrouter

# 1. Google Gemini Studio Keys (If using Gemini directly)
NEXT_PUBLIC_GEMINI_API_KEY=

# 2. OpenRouter API Keys (Recommended: extremely cheap, bypasses Google Studio quotas)
# Suggested Models: google/gemini-2.5-flash | openai/gpt-4o-mini | deepseek/deepseek-chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Google Maps (Optional, defaults to Leaflet OpenStreetMap if not set)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Pinecone Database Credentials (For RAG vector searches)
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_ENVIRONMENT=
